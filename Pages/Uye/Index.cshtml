@page "{id:int?}"
@model DernekTakip.Pages.Uye.IndexModel
@using DernekTakip.Servisler
@{
    ViewData["Title"] = "Üyeler";
}

<div class="uye-sayfa@(Model.Yazdir ? " yazdir" : null)">
<h1>Üyeler</h1>
<p class="ozet">Gruplar: Üyeler, Yöneticiler (aidatlı); Çalışanlar, Bağış, Diğer (aidatsız).</p>
@if (Model.Uyari is not null) { <p class="uyari">@Model.Uyari</p> }
@if (Model.Tamam is not null) { <p class="tamam">@Model.Tamam</p> }

<div class="uye-liste-bar">
    <div class="uye-filtre">
        @foreach (var d in new[] { "Tümü", "Aktif", "Ayrıldı" })
        {
            if (d == Model.DurumFiltre)
            {
                <a class="uye-filtre-btn secili" href="@Model.ListeAdres(d)">@d</a>
            }
            else
            {
                <a class="uye-filtre-btn" href="@Model.ListeAdres(d)">@d</a>
            }
        }
    </div>
    <div class="uye-liste-sag">
        <strong class="uye-sayi">@Model.UyeSayisi</strong>
        <form class="uye-yil" method="get" action="@Model.Yol("/Uye")">
            <input type="hidden" name="durum" value="@Model.DurumFiltre" />
            <label>Yıl
                <select name="yil" onchange="this.form.submit()">
                    @foreach (var y in Model.Yillar)
                    {
                        if (y == Model.Yil)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </label>
        </form>
    </div>
</div>

@if (Model.Yonetici)
{
    <form id="uye-sil" method="post" asp-page-handler="Sil">
        <input type="hidden" name="DurumFiltre" value="@Model.DurumFiltre" />
        <input type="hidden" name="Yil" value="@Model.Yil" />
    </form>
}

<partial name="_Sayfalama" model="Model.Sayfalar" />
<div class="uye-ad-ara">
    <span class="uye-ad-ara-yazi">Üye Arama</span>
    <div class="uye-ad-ara-kutu">
        <input type="search" id="uye-ad-ara" placeholder="Filtreleme" autocomplete="off" value="@Model.AraSecilen" />
        <div class="uye-ad-ara-liste" id="uye-ad-ara-liste" hidden></div>
    </div>
    <div class="uye-ad-ara-sag">
        <a class="btn-yazici" href="@Model.YazdirAdres()" title="Yazdır" aria-label="Yazdır">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path fill="currentColor" d="M7 3h10v5H7V3zm12 6H5a2 2 0 0 0-2 2v6h4v-2h10v2h4v-6a2 2 0 0 0-2-2zM7 17h10v4H7v-4z"/>
            </svg>
        </a>
        <a class="btn-ince btn-ornek-excel" href="@Model.OrnekExcelAdres()" title="Örnek Excel şablonunu indir">Örnek Excel</a>
        <a class="btn btn-excel-ekle" id="btn-excel-ac" href="@Model.ExcelAdres()">Excel'den Ekle</a>
        <a class="btn btn-yeni-uye" href="@Model.YeniUyeAdres()">Yeni Üye</a>
    </div>
</div>
<div class="tablo-sar">
    <table class="tablo">
        <thead>
            <tr class="uye-baski-ust">
                <th colspan="6">
                    <div class="uye-baski-ad"><span>@(ViewData["DernekAd"] as string ?? "Dernek Takip")</span></div>
                </th>
            </tr>
            <tr>
                <th>Ad Soyad</th>
                <th>Grup</th>
                <th>Telefon</th>
                <th class="sag">Borç</th>
                <th class="sag">Ödenen</th>
                <th class="sag">Kalan</th>
                <th class="uye-islem"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Liste)
        {
            <tr>
                <td>@u.AdSoyad</td>
                <td>@u.GrupAd</td>
                <td>@u.Telefon</td>
                <td class="sag">@Depo.Tl(u.Borc)</td>
                <td class="sag">@Depo.Tl(u.Odenen)</td>
                <td class="sag @(u.Kalan > 0 ? "kalan-var" : u.Kalan < 0 ? "kalan-fazla" : null)">@Depo.TlMutlak(u.Kalan)</td>
                <td class="uye-islem">
                    <a class="btn-duzenle" href="@Model.Yol("/Uye/" + u.Id + "?durum=" + Uri.EscapeDataString(Model.DurumFiltre) + "&yil=" + Model.Yil)">Düzenle</a>
                    <a class="btn-ince" href="@Model.OdemelerAdres(u.Id)">Ödemeler</a>
                    @if (Model.Yonetici)
                    {
                        <button class="btn-sil" type="submit" form="uye-sil" name="Id" value="@u.Id">Sil</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<script>
(function () {
  var data = @Html.Raw(Model.AraJson);
  var q = document.getElementById("uye-ad-ara");
  var liste = document.getElementById("uye-ad-ara-liste");
  if (!q || !liste || !Array.isArray(data)) return;
  var taban = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListeAdres()));
  function kucuk(s) { return String(s || "").toLocaleLowerCase("tr"); }
  function kapat() { liste.hidden = true; liste.replaceChildren(); }
  function yaz(hits) {
    liste.replaceChildren();
    if (hits.length === 0) {
      var bos = document.createElement("div");
      bos.className = "bos";
      bos.textContent = "Eşleşen üye yok.";
      liste.appendChild(bos);
    } else {
      hits.forEach(function (u) {
        var a = document.createElement("a");
        a.href = taban + "&sec=" + u.id;
        a.textContent = u.ad;
        liste.appendChild(a);
      });
    }
    liste.hidden = false;
  }
  q.addEventListener("input", function () {
    var s = q.value.trim();
    if (!s) {
      kapat();
      if (/\bsec=/.test(location.search)) location.assign(taban);
      return;
    }
    var n = kucuk(s);
    yaz(data.filter(function (u) { return kucuk(u.ad).indexOf(n) === 0; }));
  });
  q.addEventListener("keydown", function (e) {
    if (e.key === "Escape") { q.value = ""; kapat(); }
  });
  document.addEventListener("click", function (e) {
    if (!e.target.closest(".uye-ad-ara")) kapat();
  });
})();
</script>
@if (Model.Yazdir)
{
<style>
@@page { size: A4 portrait; margin: 10mm 12mm 14mm; }
</style>
<script>
(function () {
  function sayfala() {
    var sar = document.querySelector(".uye-sayfa.yazdir .tablo-sar");
    if (!sar) return;
    var tablo = sar.querySelector("table");
    if (!tablo) return;
    var bas = tablo.querySelector("thead");
    var satirlar = Array.prototype.slice.call(tablo.querySelectorAll("tbody tr"));
    var adet = 22;
    var toplam = Math.max(1, Math.ceil(satirlar.length / adet));
    var kutu = document.createDocumentFragment();
    for (var i = 0; i < toplam; i++) {
      var kagit = document.createElement("div");
      kagit.className = "uye-baski-kagit";
      var t = document.createElement("table");
      t.className = "tablo";
      t.appendChild(bas.cloneNode(true));
      var govde = document.createElement("tbody");
      satirlar.slice(i * adet, (i + 1) * adet).forEach(function (s) { govde.appendChild(s); });
      t.appendChild(govde);
      kagit.appendChild(t);
      var no = document.createElement("div");
      no.className = "uye-baski-no";
      no.textContent = (i + 1) + "/" + toplam;
      kagit.appendChild(no);
      kutu.appendChild(kagit);
    }
    sar.replaceChildren(kutu);
  }
  window.addEventListener("load", function () {
    sayfala();
    window.print();
  });
  window.addEventListener("afterprint", function () {
    location.assign(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListeAdres())));
  });
})();
</script>
}
</div>

@if (Model.OdemelerUyeId != 0)
{
    <div class="uye-pencere-arka" id="uye-odeme-arka">
        <div class="uye-pencere uye-odeme-pencere" role="dialog" aria-modal="true" aria-labelledby="uye-odeme-baslik">
            <div class="form">
                <h2 id="uye-odeme-baslik">@Model.OdemelerAd — @Model.Yil Ödemeleri</h2>
                @if (Model.UyeOdemeler.Count == 0)
                {
                    <p class="ozet">Bu yılda aidat ödemesi yok.</p>
                }
                else
                {
                    <div class="odeme-liste">
                    @foreach (var o in Model.UyeOdemeler)
                    {
                        <div class="odeme-satir">
                            <strong>@o.Tarih</strong>
                            <span class="sag">@Depo.Tl(o.Tutar)</span>
                            @if (!string.IsNullOrWhiteSpace(o.Aciklama) || !string.IsNullOrWhiteSpace(o.MakbuzNo))
                            {
                                <span class="odeme-not">@o.Aciklama@(string.IsNullOrWhiteSpace(o.Aciklama) || string.IsNullOrWhiteSpace(o.MakbuzNo) ? "" : " · ")@o.MakbuzNo</span>
                            }
                        </div>
                    }
                    </div>
                }
                <div class="form-aksiyon">
                    <a class="btn-ince" href="@Model.ListeAdres()">Kapat</a>
                </div>
            </div>
        </div>
    </div>
    <script>
    document.getElementById("uye-odeme-arka")?.addEventListener("click", function (e) {
      if (e.target === this) location.assign(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListeAdres())));
    });
    </script>
}

@if (Model.KayitPencere)
{
    <div class="uye-pencere-arka" id="uye-pencere-arka">
        <div class="uye-pencere" role="dialog" aria-modal="true" aria-labelledby="uye-pencere-baslik">
            <partial name="_KayitForm" />
        </div>
    </div>
    <script>
    document.getElementById("uye-pencere-arka")?.addEventListener("click", function (e) {
      if (e.target === this) location.assign(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListeAdres())));
    });
    </script>
}

<div class="uye-pencere-arka" id="uye-excel-arka" hidden="@(!Model.ExcelPencere ? "hidden" : null)">
    <div class="uye-pencere uye-excel-pencere" role="dialog" aria-modal="true" aria-labelledby="uye-excel-baslik">
        <form id="uye-excel-form" class="form" method="post" action="@Model.Yol("/Uye?handler=ExcelYukle")" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="DurumFiltre" value="@Model.DurumFiltre" />
            <input type="hidden" name="Yil" value="@Model.Yil" />

            <div class="baslik-satir">
                <h2 id="uye-excel-baslik">Excel'den Hızlı Üye Ekle</h2>
                <a class="btn-satir-ekle" href="@Model.OrnekExcelAdres()">Örnek Excel İndir (.xlsx)</a>
            </div>

            @if (Model.ExcelPencere && Model.Uyari is not null)
            {
                <p class="uyari">@Model.Uyari</p>
            }

            <div class="excel-bilgi-kutu">
                <strong>Nasıl Çalışır?</strong>
                <p>1. Sağ üstteki <b>Örnek Excel İndir (.xlsx)</b> butonuyla hazır şablonu indirin (veya kendi üye listenizi kullanın).<br />
                   2. <b>Ad Soyad</b>, <b>Grup</b>, <b>T.C. Kimlik No</b>, <b>Telefon</b>, <b>E-posta</b>, <b>Adres</b>, <b>Durum</b> ve <b>Üye Giriş Tarihi</b> sütunlarını doldurun.<br />
                   3. Dosyayı aşağıya sürükleyip bırakın veya seçin; mükerrer T.C. kayıtları otomatik atlanarak yeni üyeler saniyeler içinde eklenir.</p>
            </div>

            <label>Grup Sütunu Boş Olanlar İçin Varsayılan Grup
                <select name="VarsayilanGrupId">
                    @foreach (var g in Model.Gruplar)
                    {
                        <option value="@g.Id">@g.Ad @(g.Aidatli ? "(aidatlı)" : "(aidatsız)")</option>
                    }
                </select>
            </label>

            <label class="excel-yukle-alan" id="uye-excel-drop" for="uye-excel-dosya">
                <input type="file" id="uye-excel-dosya" name="ExcelDosya" accept=".xlsx,.xls,.xlsm,.ods,.csv" required hidden />
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" />
                    <line x1="12" y1="3" x2="12" y2="15" />
                </svg>
                <strong id="uye-excel-dosya-ad">Excel veya CSV dosyasını buraya sürükleyin ya da tıklayıp seçin</strong>
                <span>Desteklenen formatlar: .xlsx, .xls, .csv, .ods (En fazla 10 MB)</span>
            </label>

            <label class="excel-oto-onay">
                <input type="checkbox" id="uye-excel-oto" checked />
                <span>Dosya seçildiğinde bekletmeden otomatik olarak üyeleri ekle</span>
            </label>

            <div class="form-aksiyon">
                <button type="submit" id="uye-excel-gonder">Üyeleri Hızlıca Ekle</button>
                <a class="btn-ince" id="uye-excel-kapat" href="@Model.ListeAdres()">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
<script>
(function () {
    var acBtn = document.getElementById("btn-excel-ac");
    var arka = document.getElementById("uye-excel-arka");
    var kapatBtn = document.getElementById("uye-excel-kapat");
    var form = document.getElementById("uye-excel-form");
    var inp = document.getElementById("uye-excel-dosya");
    var drop = document.getElementById("uye-excel-drop");
    var adEl = document.getElementById("uye-excel-dosya-ad");
    var oto = document.getElementById("uye-excel-oto");
    var gonderBtn = document.getElementById("uye-excel-gonder");
    if (!arka || !form || !inp) return;

    if (acBtn) {
        acBtn.addEventListener("click", function (e) {
            e.preventDefault();
            arka.hidden = false;
        });
    }
    if (kapatBtn) {
        kapatBtn.addEventListener("click", function (e) {
            if (!/\bexcel=1\b/.test(location.search)) {
                e.preventDefault();
                arka.hidden = true;
            }
        });
    }
    arka.addEventListener("click", function (e) {
        if (e.target !== arka) return;
        if (/\bexcel=1\b/.test(location.search)) {
            location.assign(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListeAdres())));
        } else {
            arka.hidden = true;
        }
    });

    function dosyaSecildi() {
        var f = inp.files && inp.files[0];
        if (!f) return;
        if (adEl) adEl.textContent = "Seçilen dosya: " + f.name;
        if (oto && oto.checked) {
            if (gonderBtn) {
                gonderBtn.disabled = true;
                gonderBtn.textContent = "Üyeler ekleniyor...";
            }
            form.submit();
        }
    }

    inp.addEventListener("change", dosyaSecildi);

    if (drop) {
        ["dragenter", "dragover"].forEach(function (evName) {
            drop.addEventListener(evName, function (e) {
                e.preventDefault();
                drop.classList.add("surukle");
            });
        });
        ["dragleave", "drop"].forEach(function (evName) {
            drop.addEventListener(evName, function (e) {
                e.preventDefault();
                drop.classList.remove("surukle");
            });
        });
        drop.addEventListener("drop", function (e) {
            var dt = e.dataTransfer;
            if (!dt || !dt.files || !dt.files.length) return;
            inp.files = dt.files;
            dosyaSecildi();
        });
    }
})();
</script>
