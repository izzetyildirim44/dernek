@page
@model MakbuzTopluModel
@{
    Layout = null;
    ViewData["Title"] = "Toplu Makbuz";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Toplu Makbuz — Dernek Takip</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        @@page { size: A4 portrait; margin: 10mm; }
    </style>
</head>
<body class="makbuz-toplu-sayfa">
    <p class="no-print"><button class="btn" type="button" onclick="window.print()">Yazdır</button>
        <a class="btn-ince" href="~/Aidat">Aidata Dön</a></p>
    @for (var i = 0; i < Model.Liste.Count; i += 2)
    {
        <div class="makbuz-kagit">
            <partial name="_MakbuzGovde" model="Model.Liste[i]" />
            @if (i + 1 < Model.Liste.Count)
            {
                <div class="makbuz-ara"></div>
                <partial name="_MakbuzGovde" model="Model.Liste[i + 1]" />
            }
        </div>
    }
    <script>
    window.addEventListener("load", function () { window.print(); });
    </script>
</body>
</html>
